        "eslint": "^8.57.0",
        "eslint-plugin-vue": "^9.26.0",
        "happy-dom": "^21.0.4",
        "laravel-vite-plugin": "^3.2.0",
        "playwright": "^1.64.1",
        "postcss": "^8.5.31",
        "tailwindcss": "^3.4.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.5",
        "vue": "^3.5.44"
